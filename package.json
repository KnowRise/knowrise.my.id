{
  "name": "knowrise.github.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:validate": "supabase db lint",
    "db:migrate": "bash -c 'source scripts/db-url.sh && supabase db push --db-url \"$PGURL\" --skip-vault'",
    "db:status": "bash -c 'source scripts/db-url.sh && supabase migration list --db-url \"$PGURL\"'",
    "db:diff": "bash -c 'source scripts/db-url.sh && supabase db diff --db-url \"$PGURL\" --schema public'",
    "db:verify": "bash -c 'source scripts/db-url.sh && psql \"$PGURL\" -v ON_ERROR_STOP=1 -f database/verify_schema.sql'"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.0.1",
    "@fortawesome/free-brands-svg-icons": "^7.0.1",
    "@fortawesome/free-solid-svg-icons": "^7.0.1",
    "@fortawesome/react-fontawesome": "^3.0.2",
    "@supabase/supabase-js": "^2.99.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-text-align": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@types/marked": "^5.0.2",
    "aos": "^2.3.4",
    "browser-image-compression": "^2.0.2",
    "lucide-react": "^0.577.0",
    "marked": "^17.0.4",
    "next": "^16.1.6",
    "postcss": "^8.5.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sanitize-html": "^2.18.1",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "supabase": "^2.118.0",
    "typescript": "^5.9.3"
  }
}
